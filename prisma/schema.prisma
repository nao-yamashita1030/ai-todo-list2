// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ユーザー情報（Clerkで管理、必要に応じて拡張）
model User {
  id        String   @id // ClerkのユーザーID
  email     String   @unique
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // リレーション
  ownedProjects    Project[]       @relation("ProjectOwner")
  projectMembers   ProjectMember[]
  createdTodos     Todo[]          @relation("TodoCreator")
  comments         Comment[]
  histories        History[]

  @@map("users")
  @@index([email])
}

// プロジェクト/フォルダ情報
model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  ownerId     String   @map("owner_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  // リレーション
  owner      User            @relation("ProjectOwner", fields: [ownerId], references: [id])
  members    ProjectMember[]
  categories Category[]
  tags       Tag[]
  todos      Todo[]

  @@map("projects")
  @@index([ownerId])
  @@index([createdAt])
}

// プロジェクトメンバー情報（共有機能用）
model ProjectMember {
  id        String   @id @default(uuid())
  projectId String  @map("project_id")
  userId    String  @map("user_id")
  role      String  @default("member") // owner, member
  createdAt DateTime @default(now()) @map("created_at")

  // リレーション
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("project_members")
  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

// カテゴリ情報
model Category {
  id        String   @id @default(uuid())
  name      String
  color     String?  // #RRGGBB形式
  projectId String?  @map("project_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // リレーション
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  todos   Todo[]

  @@map("categories")
  @@index([projectId])
}

// タグ情報
model Tag {
  id        String   @id @default(uuid())
  name      String
  color     String?  // #RRGGBB形式
  projectId String?  @map("project_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // リレーション
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  todoTags  TodoTag[]

  @@map("tags")
  @@index([projectId])
  @@index([name])
}

// TODO情報
model Todo {
  id          String    @id @default(uuid())
  title       String
  description String?
  status      String    @default("todo") // todo, in_progress, done
  priority    String?   @default("medium") // high, medium, low
  dueDate     DateTime? @map("due_date")
  projectId   String   @map("project_id")
  categoryId  String?  @map("category_id")
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  // リレーション
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  creator   User      @relation("TodoCreator", fields: [createdBy], references: [id])
  todoTags  TodoTag[]
  comments  Comment[]
  histories History[]

  @@map("todos")
  @@index([projectId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([createdBy])
  @@index([createdAt])
}

// TODOとタグの関連テーブル
model TodoTag {
  id        String   @id @default(uuid())
  todoId    String   @map("todo_id")
  tagId     String   @map("tag_id")
  createdAt DateTime @default(now()) @map("created_at")

  // リレーション
  todo Todo @relation(fields: [todoId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@map("todo_tags")
  @@unique([todoId, tagId])
  @@index([todoId])
  @@index([tagId])
}

// コメント情報
model Comment {
  id        String   @id @default(uuid())
  todoId    String   @map("todo_id")
  userId    String   @map("user_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // リレーション
  todo Todo @relation(fields: [todoId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@map("comments")
  @@index([todoId])
  @@index([userId])
  @@index([createdAt])
}

// 変更履歴情報
model History {
  id        String   @id @default(uuid())
  todoId    String   @map("todo_id")
  userId    String   @map("user_id")
  action    String   // created, updated, deleted, status_changed
  oldValue  String?  @map("old_value") // JSON形式
  newValue  String?  @map("new_value") // JSON形式
  createdAt DateTime @default(now()) @map("created_at")

  // リレーション
  todo Todo @relation(fields: [todoId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@map("histories")
  @@index([todoId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
}
